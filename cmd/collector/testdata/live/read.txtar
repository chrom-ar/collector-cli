# Read-only commands against a real Collector.
exits 0 collector whoami
stdout 'Token "'

exits 0 collector whoami --json
stdout '"organizations"'

exits 0 collector projects list
stdout '^SLUG'

exits 0 collector projects show
stdout '^DSN: '

exits 0 collector dsn

exits 0 collector issues list --range all --limit 5
exits 0 collector issues list --range all --limit 5 --json
stdout '"data"'

exits 0 collector members list
stdout '^EMAIL'

exits 0 collector origins list

# Logs: 0 where Collector keeps them, 1 where it doesn't.
exec sh -c 'collector logs --since 1h --limit 5 >/dev/null 2>&1; test $? -le 1'

# A dry-run upload sends nothing.
exits 0 collector upload dist --release live-test --dry-run
stdout 'dry run: nothing sent'

-- dist/app.js --
console.log(1);
