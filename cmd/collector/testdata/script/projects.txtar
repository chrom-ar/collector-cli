env COLLECTOR_TOKEN=cltp_test_token_laptop

# Two organizations: which one must be said, and the error lists them.
fake-collector me.ok projects.list.ok
exits 2 collector projects list
stderr '^error: you''re in 2 organizations; pass --org acme \(or globex\)$'
stderr '^or set a default for this Collector: collector use <org>\[/<project>\]$'
stderr '^Run collector --help for usage\.$'

exits 0 collector projects list --org acme
cmp stdout list.txt
! stderr .

exits 0 collector projects list --org acme --json
stdout '"slug": "api"'
stdout '"next_cursor": null'

# One page with a More hint on stderr.
fake-collector projects.list.next_page
exits 0 collector projects list --org acme --limit 1 --cursor cursor_test_next
stdout '^shop  Shop'

# show and dsn, with the project named or implied.
env COLLECTOR_ORG=acme
fake-collector project.get.ok project.get.no_dsn
exits 0 collector projects show shop
stdout '^Shop \(shop\)$'
stdout '^http://127\.0\.0\.1:\d+/o/acme/p/shop$'
stdout '^DSN: http://clt_test_key_shop@clt\.test$'

exits 1 collector dsn shop
stderr '^error: shop has no DSN to show\. This project''s key is from before DSNs'
! stdout .

fake-collector project.get.ok
exits 0 collector dsn shop
stdout '^http://clt_test_key_shop@clt\.test$'

fake-collector project.get.not_found
exits 1 collector projects show nope
stderr '^error: That doesn''t exist, or this token can''t see it\.$'

# create prints the DSN; 422 lists the fields and exits 1; a read-only
# token exits 3 with a hint.
fake-collector projects.create.ok projects.create.invalid
exits 0 collector projects create Docs
stdout '^Docs \(docs\)$'
stdout '^DSN: http://clt_test_key_docs@'
stderr '^Setting it up with an AI coding agent: collector guide$'
exits 1 collector projects create ''
stderr '^error: Some values aren''t valid\.$'
stderr '^  name: can''t be blank$'

fake-collector projects.create.read_only
exits 3 collector projects create Docs
stderr '^error: This token is read-only\.$'
stderr 'this token is read-only; create one with write access'

-- list.txt --
SLUG  NAME  PLATFORMS  UNRESOLVED  CREATED
api   API              0           5m ago
shop  Shop  elixir     1           5m ago
