env COLLECTOR_TOKEN=cltp_test_token_laptop
env COLLECTOR_ORG=acme

fake-collector project.update.ok project.update.invalid project.mute.ok project.unmute.ok
exits 0 collector projects edit shop --name Storefront
stdout '^Storefront \(shop\)$'
exits 2 collector projects edit shop
stderr 'say the new name with --name'

exits 0 collector projects mute shop
stdout '^shop''s issue emails are off for you\.$'
exits 0 collector projects unmute shop
stdout '^shop''s issue emails are on for you\.$'

# One event, told as Markdown.
env COLLECTOR_PROJECT=shop
fake-collector issue.event.markdown
exits 0 collector issues event Err7Kq2XpAb2 00000000-0000-4000-8000-000000000001 --markdown
stdout '^# Ecto\.NoResultsError$'
