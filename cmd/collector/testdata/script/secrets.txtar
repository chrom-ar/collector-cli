env COLLECTOR_TOKEN=cltp_test_token_laptop
env COLLECTOR_ORG=acme
env COLLECTOR_PROJECT=shop

fake-collector upload-tokens.list.ok upload-tokens.create.ok upload-tokens.revoke.ok
exits 0 collector upload-tokens list
stdout '^ID            NAME            TOKEN       LAST USED  CREATED BY    CREATED$'
stdout '^Upt7Kq2XpAb2  GitHub Actions  cltu_…test  never      Ada Lovelace  5m ago$'

# The secret goes to stdout once; the warning to stderr.
exits 0 collector upload-tokens create 'GitHub Actions'
stdout '^cltu_test_upload_ci$'
stderr '^Upload token "GitHub Actions" \(Upt7Kq2XpAb2\):$'
stderr '^This is the only time it''s shown\. Store it as COLLECTOR_UPLOAD_TOKEN'

exits 0 collector upload-tokens create 'GitHub Actions' --json
stdout '"secret": "cltu_test_upload_ci"'
stderr 'only time it''s shown'

exits 0 collector upload-tokens revoke Upt7Kq2XpAb2
stdout '^Revoked\.$'

# A member can't: exit 1, with a hint naming the organization.
env COLLECTOR_TOKEN=cltp_test_token_bob
fake-collector upload-tokens.list.forbidden
exits 1 collector upload-tokens list
stderr '^ask an owner or admin of acme$'

env COLLECTOR_TOKEN=cltp_test_token_laptop
fake-collector server-keys.list.ok server-keys.create.ok server-keys.revoke.ok
exits 0 collector server-keys list
stdout 'clts_…test'
exits 0 collector server-keys create 'API servers'
stdout '^clts_test_server_api$'
stderr 'COLLECTOR_SERVER_KEY'
exits 0 collector server-keys revoke Srv7Kq2XpAb2
stdout '^Revoked\.$'

# Unknown and missing actions are usage mistakes.
exits 2 collector server-keys frob
stderr 'unknown action "frob" for server-keys \(use create, list, revoke\)'
exits 2 collector server-keys
stderr 'server-keys needs an action: create, list, revoke'
exits 2 collector server-keys create
stderr 'missing arguments: collector server-keys create <name>'
