env COLLECTOR_TOKEN=cltp_test_token_laptop
env COLLECTOR_ORG=acme
env COLLECTOR_PROJECT=shop

fake-collector origins.list.ok origins.allow.ok origins.block.ok origins.forget.ok
exits 0 collector origins list
stdout '^https://shop\.example\.com  pending  5m ago$'

# A bare host means https://.
exits 0 collector origins allow shop.example.com
stdout '^https://shop\.example\.com: allowed$'
exits 0 collector origins block https://shop.example.com
stdout ': blocked$'
exits 0 collector origins forget shop.example.com
stdout '^Forgot https://shop\.example\.com; its next event will ask again\.$'
