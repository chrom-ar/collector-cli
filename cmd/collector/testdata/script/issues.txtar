env COLLECTOR_TOKEN=cltp_test_token_laptop
env COLLECTOR_ORG=acme
env COLLECTOR_PROJECT=shop

fake-collector issues.list.ok issues.list.filtered issues.list.empty
exits 0 collector issues list --limit 1
stdout '^ID            LEVEL  TITLE                           EVENTS  USERS  LAST SEEN  ASSIGNEE$'
stdout '^Err8Mn3YqBc3  error  TypeError: x is not a function  1       1      5m ago$'
stderr '^More: --cursor cursor_test_issues$'

exits 0 collector issues list --status resolved --range all --env production --platform javascript --release web@1.4.2 --search TypeError
stdout '^Err8Mn3YqBc3'

exits 0 collector issues list nothing matches this
stdout '^No unresolved issues seen in the last week \(matching "nothing matches this"\)\.$'

# -q is --quiet here too; the search is words or --search.
exits 0 collector issues list -q --search 'nothing matches this'
stdout 'No unresolved issues'
exits 2 collector issues list nothing --search else
stderr 'as words or as --search, not both'

# A bare id without --org/--project goes through /issues/:id and its 308.
env COLLECTOR_ORG=
env COLLECTOR_PROJECT=
fake-collector issue.find.ok issue.get.ok issue.get.markdown
exits 0 collector issues show Err7Kq2XpAb2
stdout '^Ecto\.NoResultsError'
stdout '^unresolved · error · elixir · 1 event · 1 user$'
stdout '^First seen 5m ago \(v57\) · last seen 5m ago \(v57\)$'
stdout '^At lib/shop/orders\.ex:88 in '
stdout '^http://127\.0\.0\.1:\d+/o/acme/p/shop/issues/Err7Kq2XpAb2$'
stderr 'collector issues show Err7Kq2XpAb2 --markdown'

# --markdown prints Collector's text as is.
fixture-body issue.get.markdown issue.md
exits 0 collector issues show $URL/o/acme/p/shop/issues/Err7Kq2XpAb2 --markdown
stdout '^# Ecto\.NoResultsError$'
stdout '^## Stacktrace$'

exits 0 collector issues show Err7Kq2XpAb2 --org acme --project shop --json
stdout '"latest_event": \{'

# A merged issue's old path answers 308 to the new one.
fake-collector issue.get.merged issue.get.ok
exits 0 collector issues show Mrg9Pq4ZrCd4 --org acme --project shop
stdout '^Ecto\.NoResultsError'

fake-collector issue.get.not_found
exits 1 collector issues show Nope7Kq2XpAb --org acme --project shop
stderr '^error: '

# An issue URL on another Collector is a usage mistake.
exits 2 collector issues show http://elsewhere.test/o/a/p/b/issues/Err7Kq2XpAb2
stderr 'that issue is on http://elsewhere\.test'

env COLLECTOR_ORG=acme
env COLLECTOR_PROJECT=shop
fake-collector issue.events.ok issue.event.ok issue.event.not_kept
exits 0 collector issues events Err7Kq2XpAb2
stdout '^EVENT                                 OCCURRED  ENVIRONMENT  RELEASE  DETAILS$'
stdout '^00000000-0000-4000-8000-000000000002  5m ago    prod         v57      kept$'

exits 0 collector issues event Err7Kq2XpAb2 00000000-0000-4000-8000-000000000001
stdout '^00000000-0000-4000-8000-000000000001 · 2026-11-13 12:00:00'
stdout '^> lib/shop/orders\.ex:88'

exits 0 collector issues event Err7Kq2XpAb2 00000000-0000-4000-8000-000000000002
stdout 'Stored without details'

# Changes: one line per issue.
fake-collector issue.update.resolved issue.update.ignored issue.update.reopened issue.update.assigned issue.update.unassigned issue.update.not_member
exits 0 collector issues resolve Err7Kq2XpAb2
stdout '^Err7Kq2XpAb2 resolved$'
exits 0 collector issues ignore Err7Kq2XpAb2
stdout '^Err7Kq2XpAb2 ignored$'
exits 0 collector issues assign Err7Kq2XpAb2 me
stdout '^Err7Kq2XpAb2 assigned to ada@example\.com$'
exits 0 collector issues assign Err7Kq2XpAb2 none
stdout '^Err7Kq2XpAb2 unassigned$'
exits 1 collector issues assign Err7Kq2XpAb2 stranger@example.com
stderr '^error: Err7Kq2XpAb2: Some values aren''t valid\.$'
stderr '^  assignee: isn''t a member of this organization$'
