env COLLECTOR_TOKEN=cltp_test_token_laptop
env COLLECTOR_ORG=acme

# Newest first; ids whole; the next page on stderr.
fake-collector audits.list.ok
exits 0 collector audit --limit 2
stdout '^ID            WHEN    ACTOR         ACTION           TARGET                VIA          CHANGES$'
stdout '^Adt9Pq4ZrCd4  5m ago  Ada Lovelace  project\.updated  project PrjShop7Kq2X  CLI: laptop  name: Shop 2 → Shop 3$'
stdout '^Adt8Mn3YqBc3  5m ago  Ada Lovelace  project\.updated  project PrjShop7Kq2X  CLI: laptop  name: Shop 1 → Shop 2$'
stderr '^More: --cursor cursor_test_audits$'

exits 0 collector audit --limit 2 --json
stdout '"next_cursor": "cursor_test_audits"'
stdout '"ip": "198\.51\.100\.7"'

# Owners and admins only.
env COLLECTOR_TOKEN=cltp_test_token_bob
fake-collector audits.list.forbidden
exits 1 collector audit
stderr '^error: Your role here doesn''t allow it'
stderr '^ask an owner or admin of acme$'

# The audit log takes no filters.
exits 2 collector audit --actor ada@example.com
stderr 'unknown flag: --actor'
exits 2 collector audit project
stderr 'unexpected arguments: project'
